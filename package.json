{
  "name": "obsidian-vault-sync",
  "private": true,
  "workspaces": [
    "apps/plugin",
    "apps/server",
    "libs/shared",
    "libs/framework",
    "libs/interaction"
  ],
  "type": "module",
  "scripts": {
    "dev:enable": "bun --watch scripts/enable-dev.ts",
    "dev": "bun run --parallel dev:plugin dev:server",
    "server": "bun run --filter \"@nimir/obsidian-vault-sync-server\" serve",
    "dev:plugin": "bun run --filter \"@nimir/obsidian-vault-sync-plugin\" dev",
    "dev:server": "bun --env-file=apps/server/.env --watch apps/server/src/server.ts",
    "test": "bun test",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  }
}
